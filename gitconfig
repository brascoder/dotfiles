[include]
  path = ~/.gitconfig.local
[alias]
  a = add .
  co = checkout
  cm = commit -m
  cl = commit --amend -C HEAD
  st = status
  br = branch
[core]
  excludesfile = ~/.gitignore
[push]
  default = simple
[pull]
  rebase = true
[remote "origin"]
  push = HEAD
[merge]
  tool = opendiff
[credential]
  helper = osxkeychain
[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
